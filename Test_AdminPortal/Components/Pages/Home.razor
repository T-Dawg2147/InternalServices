@page "/"
@using Test_AdminPortal.Services
@inject UserContext UserContext
@inject PortalCatalogOptions Catalog

<PageTitle>Home</PageTitle>

<div class="page launcher-page">
    <header class="launcher-header">
        <div>
            <p class="eyebrow">INTERNAL SERVICES</p>
            <h1>Welcome, @_displayName</h1>
            <p class="muted">Choose a tool to get started.</p>
        </div>
        <span class="launcher-count">@_tools.Count available</span>
    </header>

    <div class="launcher-toolbar">
        <label class="sr-only" for="tool-search">Search available tools</label>
        <input id="tool-search"
               class="tool-search"
               type="search"
               placeholder="Search your tools"
               @bind="_search"
               @bind:event="oninput" />
    </div>

    @if (_tools.Count == 0)
    {
        <section class="empty-state" aria-live="polite">
            <span class="empty-state-mark" aria-hidden="true">—</span>
            <h2>No tools assigned yet</h2>
            <p class="muted">Ask an administrator to grant access to the tools you need.</p>
        </section>
    }
    else if (!FilteredTools.Any())
    {
        <section class="empty-state" aria-live="polite">
            <h2>No matching tools</h2>
            <p class="muted">Try another search term.</p>
        </section>
    }
    else
    {
        @foreach (var category in FilteredTools.GroupBy(tool => tool.Category)
            .OrderBy(group => group.Key, StringComparer.OrdinalIgnoreCase))
        {
            <section class="tool-category" aria-label="@category.Key tools">
                <h2 class="category-title">@category.Key</h2>
                <div class="grid launcher-grid">
                    @foreach (var tool in category)
                    {
                        <NavLink class="card link-card tool-card" href="@tool.Route">
                            <span class="tool-icon" aria-hidden="true">@tool.IconText</span>
                            <span class="tool-card-content">
                                <span class="tool-card-title">@tool.Title</span>
                                <span class="tool-card-description">@tool.Description</span>
                            </span>
                            <span class="tool-card-arrow" aria-hidden="true">→</span>
                        </NavLink>
                    }
                </div>
            </section>
        }
    }
</div>

@code {
    private string _displayName = string.Empty;
    private string _search = string.Empty;
    private IReadOnlyList<string> _permissions = Array.Empty<string>();
    private IReadOnlyList<PortalToolOptions> _tools = Array.Empty<PortalToolOptions>();

    private IEnumerable<PortalToolOptions> FilteredTools =>
        string.IsNullOrWhiteSpace(_search)
            ? _tools
            : _tools.Where(tool =>
                tool.Title.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
                tool.Description.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
                tool.Category.Contains(_search, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        _displayName = await UserContext.GetDisplayNameAsync();
        _permissions = await UserContext.GetPermissionsAsync();
        _tools = Catalog.Tools
            .Where(tool =>
                string.IsNullOrWhiteSpace(tool.RequiredPermission) ||
                _permissions.Contains(tool.RequiredPermission, StringComparer.OrdinalIgnoreCase))
            .OrderBy(tool => tool.Category, StringComparer.OrdinalIgnoreCase)
            .ThenBy(tool => tool.Title, StringComparer.OrdinalIgnoreCase)
            .ToList();
    }
}